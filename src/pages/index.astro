---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Purpose from '@/components/home/Purpose.astro';
import Solutions from '@/components/home/Solutions.astro';
import MissionVision from '@/components/home/MissionVision.astro';
import Accolades from '@/components/home/Accolades.astro';
import ContactForm from '@/components/home/ContactForm.astro';
---

<BaseLayout
  title={SITE.title}
  description={SITE.description}
  type="website"
  keywords="Security, Privacy, Engineered for Operational Continuity, SPEOC, Enterprise cybersecurity, privacy governance consulting, executive boards, security leaders"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    sameAs: Object.values(SITE.socials),
  }}
>
  <Hero />
  <Purpose />
  <Solutions />
  <MissionVision />
  <Accolades />
  <ContactForm />

  <!-- Hidden SEO Keywords Block -->
  <div class="sr-only" aria-hidden="true" data-ps="src/pages/index.astro:seo-keywords">
    Security, Privacy, Engineered for Operational Continuity, SPEOC, Enterprise cybersecurity, privacy governance consulting, executive boards, security leaders, Risk Management, Digital Resilience, Identity Management, Keys Cryptography, Asia-Pacific, 斯安, 網絡安全, 私隱保護, 人工智能風險治理, 風險治理, 後量子密碼學, 密鑰管理, 數碼韌性.
  </div>
</BaseLayout>
