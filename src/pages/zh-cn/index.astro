---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Purpose from '@/components/home/Purpose.astro';
import Solutions from '@/components/home/Solutions.astro';
import MissionVision from '@/components/home/MissionVision.astro';
import Accolades from '@/components/home/Accolades.astro';
import ContactForm from '@/components/home/ContactForm.astro';
---

<BaseLayout
  title={`SPEOC「斯安」有限公司`}
  description="以安全与隐私为基石，为客户打造优化卓越、持续领先的解决方案。"
  lang="zh-CN"
  keywords="斯安, 网络安全, 隐私保护, 人工智能风险治理, 风险治理, 后量子密码学, 密钥管理, 数字韧性"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: "SPEOC「斯安」有限公司",
    url: new URL(Astro.url.pathname, SITE.url).toString(),
    sameAs: Object.values(SITE.socials),
  }}
>
  <section id="hero" class="relative overflow-hidden bg-background pt-[var(--nav-height)] pb-12 md:pb-24" data-ps="src/pages/zh-cn/index.astro:e26gru">
    <Container class="relative z-10">
      <div class="flex flex-col items-center text-center" data-ps="src/pages/zh-cn/index.astro:5krver">
        <!-- Text Block -->
        <div class="w-full max-w-4xl py-12 md:py-20 flex flex-col items-center justify-center" data-ps="src/pages/zh-cn/index.astro:5krves">
          <div class="inline-flex items-center gap-2 mb-8 reveal" data-ps="src/pages/zh-cn/index.astro:ksv3wk">
            <span class="h-px w-8 bg-primary" data-ps="src/pages/zh-cn/index.astro:s2kjgp"></span>
            <span class="text-sm font-bold tracking-widest uppercase text-primary" data-ps="src/pages/zh-cn/index.astro:s2kjgo">Strategic Advisory</span>
            <span class="h-px w-8 bg-primary" data-ps="src/pages/zh-cn/index.astro:s2kjgn"></span>
          </div>
          
          <h1 class="text-h1 font-bold mb-8 text-foreground leading-[1.05] reveal" data-ps="src/pages/zh-cn/index.astro:hep1u0">
             SPEOC <span class="text-primary italic" data-ps="src/pages/zh-cn/index.astro:s2kjgm">「斯安」有限公司</span> 
          </h1>
          
          <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto text-muted-foreground leading-relaxed reveal reveal-delay-1" data-ps="src/pages/zh-cn/index.astro:eelz3w">
            以安全与隐私为基石，为客户打造优化卓越、持续领先的解决方案。
          </p>
          <p class="text-lg mb-12 max-w-3xl mx-auto text-muted-foreground leading-relaxed reveal reveal-delay-1" data-ps="src/pages/zh-cn/index.astro:eelz3x">
            「斯安」是一家专注于网络安全、隐私保护及人工智能风险治理的专业咨询公司。我们协助全球企业将风险与合规要求，转化为韧性与战略优势。<br/><br/>
            <strong>服务范畴：</strong>风险治理、后量子密码学、密钥管理、人员与机器身份管理，以及数字韧性。
          </p>
          
          <div class="flex flex-wrap justify-center gap-4 reveal reveal-delay-2" data-ps="src/pages/zh-cn/index.astro:ksv3wl">
            <a href="#solutions" class="px-8 py-4 bg-primary text-primary-foreground font-bold rounded-sm hover:bg-primary-hover transition-all hover-lift" data-ps="src/pages/zh-cn/index.astro:lijvss">
              Practice Areas
            </a>
            <a href="#accolades" class="px-8 py-4 border border-secondary text-secondary font-bold rounded-sm hover:bg-secondary hover:text-secondary-foreground transition-all" data-ps="src/pages/zh-cn/index.astro:lijvst">
              Industry Leadership
            </a>
            <a href="#contact" class="px-8 py-4 border border-secondary text-secondary font-bold rounded-sm hover:bg-secondary hover:text-secondary-foreground transition-all" data-ps="src/pages/zh-cn/index.astro:lijvsu">
              Contact Advisory
            </a>
          </div>

          <!-- Diagnostic Micro-Ledger -->
          <div class="mt-16 grid grid-cols-2 md:grid-cols-3 gap-8 pt-8 w-full border-t border-border reveal reveal-delay-3" data-ps="src/pages/zh-cn/index.astro:ksv3wm">
            <div data-ps="src/pages/zh-cn/index.astro:ksv3wn">
              <span class="block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1" data-ps="src/pages/zh-cn/index.astro:s2kjgl">Geographical coverage</span>
              <span class="block text-xl md:text-2xl font-bold text-foreground" data-ps="src/pages/zh-cn/index.astro:s2kjgk">Asia-Pacific</span>
            </div>
            <div data-ps="src/pages/zh-cn/index.astro:ksv3wo">
              <span class="block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1" data-ps="src/pages/zh-cn/index.astro:s2kjgj">Compliance</span>
              <span class="block text-xl md:text-2xl font-bold text-foreground" data-ps="src/pages/zh-cn/index.astro:s2kjfx">Cybersecurity, Privacy</span>
            </div>
            <div class="hidden md:block" data-ps="src/pages/zh-cn/index.astro:ksv3wp">
              <span class="block text-xs font-bold uppercase tracking-widest text-muted-foreground mb-1" data-ps="src/pages/zh-cn/index.astro:s2kjfw">Delivery</span>
              <span class="block text-xl md:text-2xl font-bold text-foreground" data-ps="src/pages/zh-cn/index.astro:s2kjfv">Solutions + Services</span>
            </div>
          </div>
        </div>

        <!-- Image Block -->
        <div class="w-full relative h-[400px] md:h-[500px] lg:h-[650px] mt-8 rounded-sm overflow-hidden reveal-up border border-border" data-ps="src/pages/zh-cn/index.astro:ksv3wq">
          <div class="absolute inset-0" data-ps="src/pages/zh-cn/index.astro:ksv3wr">
            <div class="relative h-full w-full overflow-hidden" data-ps="src/pages/zh-cn/index.astro:ksv3ws">
              <img 
                src="https://pagesmith-cdn.com/462bac59/images/change-the-text-on-the-laptop-screen-to-read-speoc-instead-o-65b6-1024.webp" 
                srcset="https://pagesmith-cdn.com/462bac59/images/change-the-text-on-the-laptop-screen-to-read-speoc-instead-o-65b6-1024.webp 1024w, https://pagesmith-cdn.com/462bac59/images/change-the-text-on-the-laptop-screen-to-read-speoc-instead-o-65b6-768.webp 768w, https://pagesmith-cdn.com/462bac59/images/change-the-text-on-the-laptop-screen-to-read-speoc-instead-o-65b6-640.webp 640w, https://pagesmith-cdn.com/462bac59/images/change-the-text-on-the-laptop-screen-to-read-speoc-instead-o-65b6-320.webp 320w"
                sizes="100vw"
                alt="Diverse executive consulting team with SPEOC displayed on laptop and glass partition" 
                class="h-full w-full object-cover object-center"
                loading="eager"
                fetchpriority="high" data-ps="src/pages/zh-cn/index.astro:32ir39" />
              <div class="absolute inset-0 bg-secondary/10 mix-blend-multiply" data-ps="src/pages/zh-cn/index.astro:ksv3wt"></div>
            </div>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <Purpose />
  <Solutions />
  <MissionVision />
  <Accolades />
  <ContactForm />

  <!-- Hidden SEO Keywords Block -->
  <div class="sr-only" aria-hidden="true" data-ps="src/pages/zh-cn/index.astro:seo-keywords">
    斯安, 网络安全, 隐私保护, 人工智能风险治理, 风险治理, 后量子密码学, 密钥管理, 数字韧性, SPEOC, Security, Privacy, Engineered for Operational Continuity, Enterprise cybersecurity.
  </div>
</BaseLayout>
